{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app",
      "functions": {
        "backend/main.py": {
          "maxDuration": 30,
          "excludeFiles": "{web/**,app/**,tests/**,.venv/**,**/__pycache__/**,**/*.pyc,data/raw/**,data/warehouse.duckdb*,.pytest_cache/**,scripts/**,.github/**,**/.next/**,**/node_modules/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/docs", "destination": { "service": "api" } },
    { "source": "/docs/:path*", "destination": { "service": "api" } },
    { "source": "/openapi.json", "destination": { "service": "api" } },
    { "source": "/redoc", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
