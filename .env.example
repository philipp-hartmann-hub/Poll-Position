# Lokal, nicht committen (.env steht in .gitignore).
# NIEMALS echte Tokens in Git committen — nur diese Platzhalter-Datei.

DAWUM_API_KEY=

# MotherDuck: ohne Token → lokale Datei data/warehouse.duckdb
# Mit Token → Silver/Gold in MotherDuck (md:$MOTHERDUCK_DATABASE)
#
# GitHub Actions (Daily Pipeline): Secrets MOTHERDUCK_TOKEN + optional MOTHERDUCK_DATABASE
#   → Settings → Secrets and variables → Actions
# Vercel: Marketplace setzt MOTHERDUCK_TOKEN automatisch
#
# Docs: https://motherduck.com/docs/key-tasks/authenticating-and-connecting-to-motherduck/connecting-to-motherduck/
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=poll_position
# Optional (nur Lesezugriff, z. B. reine API):
# MOTHERDUCK_READONLY_TOKEN=
